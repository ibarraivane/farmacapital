{
  "buildCommand": "CI=false DISABLE_ESLINT_PLUGIN=true GENERATE_SOURCEMAP=false NODE_OPTIONS=--max-old-space-size=4096 npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhooks/whatsapp",
      "destination": "/api/health"
    },
    {
      "source": "/api/webhooks/rappi-sync",
      "destination": "/api/backup?action=rappi-sync"
    },
    {
      "source": "/api/webhooks/rappi-order",
      "destination": "/api/logistics/webhook?type=rappi-order"
    },
    {
      "source": "/api/rh/documento",
      "destination": "/api/admin/storage-upload?type=rh-documento"
    },
    {
      "source": "/api/precios/buscar",
      "destination": "/api/inventarioProcesarPdf?type=buscar-similares"
    },
    {
      "source": "/api/precios/actualizar-compra",
      "destination": "/api/inventarioProcesarPdf?type=actualizar-compra"
    },
    {
      "source": "/api/whatsapp/send",
      "destination": "/api/notifications/send?type=whatsapp"
    },
    {
      "source": "/api/notifications/cita-confirmacion",
      "destination": "/api/notifications/send?type=cita"
    },
    {
      "source": "/api/notifications/order-receipt",
      "destination": "/api/notifications/send?type=order"
    },
    {
      "source": "/api/notifications/pos-ticket",
      "destination": "/api/notifications/send?type=pos-ticket"
    },
    {
      "source": "/api/recibos/ensure",
      "destination": "/api/notifications/send?type=recibo-ensure"
    },
    {
      "source": "/r/:token",
      "destination": "/api/health?token=:token"
    },
    {
      "source": "/api/payments/mp/balance",
      "destination": "/api/payments/mp/point?action=balance"
    },
    {
      "source": "/((?!api/|static/|icons/|manifest\\.json|service-worker\\.js|favicon\\.ico|asset-manifest\\.json|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/health",
      "schedule": "0 12 * * *"
    }
  ]
}
