{
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "CI=false DISABLE_ESLINT_PLUGIN=true GENERATE_SOURCEMAP=false NODE_OPTIONS=--max-old-space-size=4096 npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://sdk.mercadopago.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://appleid.apple.com https://www.facebook.com https://graph.facebook.com https://api.mercadopago.com https://www.mercadopago.com https://www.mercadopago.com.mx; frame-src https://*.supabase.co https://accounts.google.com https://appleid.apple.com https://www.facebook.com https://www.mercadopago.com https://www.mercadopago.com.mx https://www.mercadolibre.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.supabase.co https://accounts.google.com https://appleid.apple.com https://www.facebook.com https://www.mercadopago.com https://www.mercadopago.com.mx"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/catalogo-propia/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/catalogo-propia/rappi_carga_stock0.csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"rappi_carga_stock0.csv\""
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/oauth-bridge",
      "destination": "/api/auth/password-reset-request?type=oauth-bridge"
    },
    {
      "source": "/api/webhooks/whatsapp",
      "destination": "/api/health"
    },
    {
      "source": "/api/webhooks/rappi-sync",
      "destination": "/api/backup?action=rappi-sync"
    },
    {
      "source": "/api/webhooks/rappi-order",
      "destination": "/api/logistics/webhook?type=rappi-order"
    },
    {
      "source": "/api/webhooks/uber-direct",
      "destination": "/api/logistics/webhook?type=uber-direct"
    },
    {
      "source": "/api/logistics/uber-direct",
      "destination": "/api/logistics/webhook?type=uber-api"
    },
    {
      "source": "/api/address/suggest",
      "destination": "/api/logistics/webhook?type=address-suggest"
    },
    {
      "source": "/api/rh/documento",
      "destination": "/api/admin/storage-upload?type=rh-documento"
    },
    {
      "source": "/api/caducidad/job",
      "destination": "/api/backup?job=caducidad"
    },
    {
      "source": "/api/monitor-precios/job",
      "destination": "/api/backup?job=monitor-precios"
    },
    {
      "source": "/api/precios/buscar",
      "destination": "/api/inventarioProcesarPdf?type=buscar-similares"
    },
    {
      "source": "/api/precios/actualizar-compra",
      "destination": "/api/inventarioProcesarPdf?type=actualizar-compra"
    },
    {
      "source": "/api/whatsapp/send",
      "destination": "/api/notifications/send?type=whatsapp"
    },
    {
      "source": "/api/notifications/cita-confirmacion",
      "destination": "/api/notifications/send?type=cita"
    },
    {
      "source": "/api/notifications/order-receipt",
      "destination": "/api/notifications/send?type=order"
    },
    {
      "source": "/api/notifications/pos-ticket",
      "destination": "/api/notifications/send?type=pos-ticket"
    },
    {
      "source": "/api/recibos/ensure",
      "destination": "/api/notifications/send?type=recibo-ensure"
    },
    {
      "source": "/api/payments/mp/balance",
      "destination": "/api/payments/mp/point?action=balance"
    },
    {
      "source": "/r/:token",
      "destination": "/api/health?token=:token"
    },
    {
      "source": "/((?!api/|static/|icons/|catalogo-propia/|brand/|manifest\\.json|service-worker\\.js|version\\.json|favicon\\.ico|asset-manifest\\.json|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/backup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/health",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/caducidad/job",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/monitor-precios/job",
      "schedule": "0 13 * * *"
    }
  ]
}
