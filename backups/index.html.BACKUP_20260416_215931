<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover" />

    <!-- PWA / Theme -->
    <meta name="theme-color" content="#0052cc" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Farmax" />
    <meta name="application-name" content="Farmax" />
    <meta name="msapplication-TileColor" content="#0052cc" />

    <!-- SEO -->
    <title>Farmax — Farmacia & Salud · Chinampac de Juárez, CDMX</title>
    <meta name="description" content="Farmax Farmacia — Medicamentos genéricos y de marca, consultorio médico y tienda en línea. Chinampac de Juárez, Iztapalapa, CDMX." />
    <meta name="keywords" content="farmacia, medicamentos, genéricos, consultorio médico, Iztapalapa, CDMX, Farmax" />
    <meta name="author" content="Farmax Farmacia" />

    <!-- Open Graph (redes sociales) -->
    <meta property="og:title" content="Farmax — Farmacia & Salud" />
    <meta property="og:description" content="Medicamentos genéricos y de marca, consultorio médico y tienda en línea. Chinampac de Juárez, CDMX." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://farmax-seven.vercel.app" />
    <meta property="og:image" content="%PUBLIC_URL%/icons/farmax-512.png" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Farmax — Farmacia & Salud" />
    <meta name="twitter:description" content="Medicamentos genéricos y de marca, consultorio médico y tienda en línea." />
    <meta name="twitter:image" content="%PUBLIC_URL%/icons/farmax-512.png" />

    <!-- Icons -->
    <link rel="icon" href="%PUBLIC_URL%/icons/farmax-72.png" />
    <link rel="apple-touch-icon" href="%PUBLIC_URL%/icons/farmax-192.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="%PUBLIC_URL%/icons/farmax-128.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="%PUBLIC_URL%/icons/farmax-192.png" />

    <!-- Manifest -->
    <link rel="manifest" href="%PUBLIC_URL%/manifest.json" />

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Estilos base -->
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overscroll-behavior: none;
      }
      /* Splash screen mientras carga */
      #splash {
        position: fixed; inset: 0; z-index: 9999;
        background: linear-gradient(135deg, #0052cc, #0099e6);
        display: flex; align-items: center; justify-content: center;
        flex-direction: column; gap: 16px;
        transition: opacity 0.5s ease;
      }
      #splash.hide { opacity: 0; pointer-events: none; }
      .splash-logo {
        width: 64px; height: 64px; border-radius: 16px;
        background: rgba(255,255,255,0.2);
        display: flex; align-items: center; justify-content: center;
      }
      .splash-capsule {
        width: 24px; height: 40px; border-radius: 12px;
        overflow: hidden; display: flex; flex-direction: column;
      }
      .splash-ct { flex: 1; background: #fff; }
      .splash-cb { flex: 1; background: rgba(255,255,255,0.4); }
      .splash-text { color: #fff; font-size: 24px; font-weight: 800; letter-spacing: -0.5px; }
      .splash-sub { color: rgba(255,255,255,0.7); font-size: 12px; letter-spacing: 2px; text-transform: uppercase; }
      .splash-loader {
        width: 40px; height: 3px; background: rgba(255,255,255,0.3);
        border-radius: 2px; overflow: hidden; margin-top: 8px;
      }
      .splash-loader-bar {
        height: 100%; width: 0; background: #fff; border-radius: 2px;
        animation: load 1.5s ease forwards;
      }
      @keyframes load { to { width: 100%; } }
      /* Ocultar scrollbar en móvil */
      ::-webkit-scrollbar { width: 4px; height: 4px; }
      ::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 2px; }
      /* Safe area para iPhone X+ */
      .safe-top    { padding-top: env(safe-area-inset-top); }
      .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
    </style>
  </head>
  <body>
    <!-- Splash screen -->
    <div id="splash">
      <div class="splash-logo">
        <div class="splash-capsule">
          <div class="splash-ct"></div>
          <div class="splash-cb"></div>
        </div>
      </div>
      <div class="splash-text">FARMAX</div>
      <div class="splash-sub">Farmacia & Salud</div>
      <div class="splash-loader"><div class="splash-loader-bar"></div></div>
    </div>

    <noscript>Para usar Farmax necesitas activar JavaScript en tu navegador.</noscript>
    <div id="root"></div>

    <script>
      // Registrar Service Worker
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js')
            .catch(e => console.warn('SW error:', e));
        });
      }
      // Ocultar splash cuando React carga
      window.addEventListener('load', () => {
        setTimeout(() => {
          const splash = document.getElementById('splash');
          if (splash) {
            splash.classList.add('hide');
            setTimeout(() => splash.remove(), 500);
          }
        }, 1200);
      });
    </script>
  </body>
</html>
