/* ═══════════════════════════════════════════
   FARMAX — Ticket Térmico Profesional 80mm
   Compatible: Epson TM-T20III, Star TSP100
   ═══════════════════════════════════════════ */

/* ── Impresión: solo mostrar el ticket ── */
@media print {
  body * { visibility: hidden !important; }
  #farmax-ticket, #farmax-ticket * { visibility: visible !important; }
  #farmax-ticket {
    position: fixed !important;
    left: 0 !important; top: 0 !important;
    width: 80mm !important;
    padding: 4mm !important;
    margin: 0 !important;
  }
  @page { size: 80mm auto; margin: 0mm; }
}

/* ── Contenedor principal ── */
#farmax-ticket {
  font-family: 'Courier New', Courier, monospace;
  font-size: 11px;
  line-height: 1.45;
  width: 280px;
  max-width: 280px;
  background: #ffffff;
  color: #000000;
  padding: 10px 8px;
  margin: 0 auto;
  box-sizing: border-box;
}

/* ── Logo / Marca ── */
.ticket-logo {
  text-align: center;
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 4px;
  margin-bottom: 2px;
  text-transform: uppercase;
}

.ticket-logo span {
  font-size: 10px;
  font-weight: normal;
  letter-spacing: 6px;
  display: block;
  margin-top: 2px;
}

/* ── Header ── */
.ticket-header {
  text-align: center;
  margin-bottom: 6px;
}

.ticket-header .pharmacy-name {
  font-size: 16px;
  font-weight: 900;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.ticket-header .pharmacy-slogan {
  font-size: 9px;
  letter-spacing: 1px;
  margin: 1px 0;
}

.ticket-header .pharmacy-address {
  font-size: 9px;
  color: #333;
  line-height: 1.4;
}

.ticket-header .pharmacy-contact {
  font-size: 9px;
  color: #333;
}

/* ── Separadores ASCII ── */
.separator {
  border: none;
  border-top: 1px dashed #000;
  margin: 5px 0;
  display: block;
}

.separator-solid {
  border: none;
  border-top: 2px solid #000;
  margin: 5px 0;
  display: block;
}

.separator-double {
  border-top: 3px double #000;
  margin: 5px 0;
  display: block;
}

.separator-text {
  text-align: center;
  font-size: 9px;
  color: #333;
  margin: 3px 0;
  letter-spacing: 1px;
}

/* ── Info de la venta ── */
.ticket-meta {
  font-size: 10px;
  margin: 2px 0;
  display: flex;
  justify-content: space-between;
}

.ticket-meta .label { color: #333; }
.ticket-meta .value { font-weight: bold; }

/* ── Tabla de productos ── */
.ticket-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 10px;
  margin: 4px 0;
}

.ticket-table thead tr {
  border-bottom: 1px dashed #000;
  border-top: 1px dashed #000;
}

.ticket-table th {
  font-weight: 900;
  text-align: left;
  padding: 3px 1px;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.ticket-table th.right,
.ticket-table td.right { text-align: right; }

.ticket-table th.center,
.ticket-table td.center { text-align: center; }

.ticket-table td {
  padding: 2px 1px;
  vertical-align: top;
  font-size: 10px;
}

.ticket-table tbody tr:last-child {
  border-bottom: 1px dashed #000;
}

.ticket-table .prod-name {
  max-width: 110px;
  word-break: break-word;
}

.ticket-table .prod-rx {
  font-size: 8px;
  background: #000;
  color: #fff;
  padding: 0 3px;
  border-radius: 2px;
  margin-left: 2px;
}

/* ── Totales ── */
.ticket-totals { margin: 4px 0; }

.ticket-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1px 0;
  font-size: 10px;
}

.ticket-total-row .amount { text-align: right; font-weight: bold; }

.ticket-total-row.subtotal { color: #333; }
.ticket-total-row.iva { color: #333; font-size: 9px; }
.ticket-total-row.descuento { color: #333; }

.ticket-total-row.total-final {
  font-size: 15px;
  font-weight: 900;
  padding: 4px 0 2px;
  border-top: 2px solid #000;
  margin-top: 3px;
}

/* ── Puntos Farmax ── */
.ticket-puntos {
  background: #000;
  color: #fff;
  text-align: center;
  padding: 5px 4px;
  font-size: 10px;
  font-weight: 900;
  margin: 6px 0;
  letter-spacing: 1px;
}

.ticket-puntos .pts-value {
  font-size: 14px;
  display: block;
  margin: 1px 0;
}

/* ── Método de pago ── */
.ticket-pago {
  font-size: 10px;
  display: flex;
  justify-content: space-between;
  margin: 2px 0;
}

/* ── QR Placeholder ── */
.qr-placeholder {
  width: 90px;
  height: 90px;
  border: 1px dashed #999;
  margin: 8px auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 8px;
  color: #999;
  text-align: center;
  line-height: 1.4;
}

.qr-placeholder .qr-label {
  font-size: 7px;
  color: #bbb;
  margin-top: 4px;
}

/* ── Footer ── */
.ticket-footer {
  text-align: center;
  margin-top: 6px;
  font-size: 9px;
  color: #333;
  line-height: 1.6;
}

.ticket-footer .gracias {
  font-size: 11px;
  font-weight: 900;
  color: #000;
  text-transform: uppercase;
  letter-spacing: 2px;
  display: block;
  margin-bottom: 3px;
}

.ticket-footer .promo-msg {
  background: #f0f0f0;
  border: 1px dashed #999;
  padding: 4px 6px;
  font-size: 9px;
  margin: 4px 0;
  font-style: italic;
}

.ticket-footer .website {
  font-size: 9px;
  color: #555;
  margin-top: 3px;
}

.ticket-footer .corte {
  margin-top: 6px;
  font-size: 9px;
  color: #bbb;
  letter-spacing: 2px;
}

/* ── Utilidades ── */
.text-center { text-align: center; }
.text-right  { text-align: right; }
.text-bold   { font-weight: 900; }
.text-small  { font-size: 9px; }
.text-gray   { color: #555; }
.clearfix::after { content: ""; display: table; clear: both; }
