  const { data, error } = await supabase
    .from("clientes")
    .select("*")
    .eq("telefono", t)
    .maybeSingle();

  if (error) {
    console.error("Error buscando cliente:", error);
    setCli(null);
    return;
  }

  setCli(data || null);
