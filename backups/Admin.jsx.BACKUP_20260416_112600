      setCart(p=>{ const ex=p.find(c=>c.id===keyU); return ex?p.map(c=>c.id===keyU?{...c,qty:c.qty+1}:c):[...p,{...item,id:keyU,qty:1,rxI:null,esUnidad:true,precio:Math.ceil(item.precio_unidad||0),nombre:item.nombre+" (unidad)"}]; });
    } else {
      setCart(p=>{
        const ex=p.find(c=>c.id===item.id);
        if(ex){
          if(ex.qty>=(item.stock||99)){ showToast(`Stock máximo: ${item.stock} unidades`,"warning"); return p; }
          return p.map(c=>c.id===item.id?{...c,qty:c.qty+1}:c);
        }
        return [...p,{...item,qty:1,rxI:null,esUnidad:false}];
