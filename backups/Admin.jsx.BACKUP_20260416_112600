// PANTALLA LOGIN
// ══════════════════════════════════════════════════════════════
function LoginScreen({onLogin}){
  const [tel,setTel]     = useState("");
  const [pwd,setPwd]     = useState("");
  const [error,setError] = useState("");
  const [loading,setLoad]= useState(false);

  const [loadErr,setLoadErr] = useState("");
  const entrar = async () => {
    if(!tel||!pwd) return;

    // ── E3: Bloqueo por intentos fallidos ──
    const bloqueoKey = "farmax_login_bloqueo_"+tel;
    const intentosKey = "farmax_login_intentos_"+tel;
    const bloqueoHasta = localStorage.getItem(bloqueoKey);
    if (bloqueoHasta && Date.now() < parseInt(bloqueoHasta)) {
      const mins = Math.ceil((parseInt(bloqueoHasta)-Date.now())/60000);
      setError(`Demasiados intentos fallidos. Intenta en ${mins} minuto${mins>1?"s":""}.`);
      return;
    }

    // ── E4: Validación mínima de contraseña ──
    if (pwd.length < 6) { setError("La contraseña debe tener al menos 6 caracteres."); return; }

    setLoad(true); setError("");
    try {
      const hash = await hashPwd(pwd);
      let { data, error:err } = await supabase
        .from("usuarios")
        .select("*")
        .eq("telefono", tel)
        .eq("password_hash", hash)
        .eq("activo", true)
        .single();

      // N2: Fallback a hash legacy para contraseñas antiguas (migración)
      if(err||!data) {
        const hashLeg = await hashPwdLegacy(pwd);
        const legRes = await supabase.from("usuarios").select("*").eq("telefono",tel).eq("password_hash",hashLeg).eq("activo",true).single();
        if(!legRes.error&&legRes.data) {
          // Migrar contraseña a hash con salt
          await supabase.from("usuarios").update({password_hash:hash}).eq("id",legRes.data.id);
          data = legRes.data; err = null;
        }
      }

      if(err||!data) {
        // Incrementar contador de intentos
        const intentos = parseInt(localStorage.getItem(intentosKey)||"0") + 1;
        localStorage.setItem(intentosKey, intentos);
        if (intentos >= 5) {
          localStorage.setItem(bloqueoKey, Date.now() + 15*60*1000);
          localStorage.removeItem(intentosKey);
          setError("Cuenta bloqueada temporalmente. Intenta en 15 minutos.");
        } else {
          setError(`Teléfono o contraseña incorrectos. (${intentos}/5 intentos)`);
        }
        setLoad(false); return;
      }

      // Login exitoso: limpiar contadores
      localStorage.removeItem(intentosKey);
      localStorage.removeItem(bloqueoKey);

      // ── E2: Guardar timestamp de login para expiración ──
      const loginData = { ...data, loginTimestamp: Date.now() };
      // L3: Guardar último acceso en Supabase
      supabase.from("usuarios").update({notas:(data.notas||"")+""}).eq("id",data.id).then(()=>{});
      localStorage.setItem("farmax_last_login_"+data.id, new Date().toLocaleString("es-MX"));
      sessionStorage.setItem("farmax_admin_user", JSON.stringify(loginData));
      logAudit(data, "LOGIN", "usuarios", data.id, {rol:data.rol});
      onLogin(loginData);
    } catch(e) {
      setError("Error de conexión. Verifica tu internet.");
    }
    setLoad(false);
  };

  return(
    <div style={{minHeight:"100vh",background:"linear-gradient(135deg,#f0f4ff 0%,#f7f9fc 50%,#e8f4fd 100%)",display:"flex",alignItems:"center",justifyContent:"center",padding:20}}>
      <div style={{width:"100%",maxWidth:400}}>
        <div style={{textAlign:"center",marginBottom:32}}>
          <div style={{display:"flex",justifyContent:"center",marginBottom:16}}><Logo size={48}/></div>
          <div style={{color:C.textMid,fontSize:14}}>Sistema de gestión · Acceso interno</div>
        </div>
        <Box style={{padding:32,boxShadow:"0 4px 24px rgba(0,82,204,.10)"}}>
          <div style={{color:C.text,fontWeight:800,fontSize:18,marginBottom:24}}>Iniciar sesión</div>
          <div style={{marginBottom:14}}>
            <div style={{color:C.textMid,fontSize:11,marginBottom:6,fontWeight:700}}>TELÉFONO</div>
            <Inp value={tel} onChange={e=>setTel(e.target.value)} placeholder="55XXXXXXXX" type="tel" style={{width:"100%",boxSizing:"border-box"}}/>
          </div>
          <div style={{marginBottom:20}}>
            <div style={{color:C.textMid,fontSize:11,marginBottom:6,fontWeight:700}}>CONTRASEÑA</div>
            <Inp value={pwd} onChange={e=>setPwd(e.target.value)} onKeyDown={e=>e.key==="Enter"&&entrar()} placeholder="••••••••" type="password" style={{width:"100%",boxSizing:"border-box"}}/>
          </div>
          {error&&<div style={{background:C.redDim,border:`1px solid ${C.red}30`,borderRadius:8,padding:"10px 12px",marginBottom:16,color:C.red,fontSize:13}}>{error}</div>}
          <Btn onClick={entrar} full col={BRAND.primary} dis={!tel||!pwd||loading}>{loading?"Verificando...":"Entrar →"}</Btn>
          <div style={{marginTop:16,textAlign:"center"}}>
            <span style={{color:C.textDim,fontSize:11}}>¿Olvidaste tu contraseña? <span style={{color:C.blue,cursor:"pointer"}}>Contacta al admin</span></span>
          </div>
        </Box>
      </div>
    </div>
  );
}

