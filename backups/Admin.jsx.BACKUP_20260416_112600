  const cobrar = async () => {
    if(!cart.length) return;
    setGuard(true);
    try {
      // N6: Crear pedido PRIMERO, luego descontar stock
      const {data:pedido} = await supabase.from("pedidos").insert({
        cliente_id: cli?.id||null,
        total, estado:"completado",
        tipo:"tienda_fisica",
        metodo_pago:pay,
        atendido_por:usuario.id,
      }).select().single();
      // Items + stock DESPUÉS del pedido (N6)
      if(pedido) {
        await supabase.from("pedido_items").insert(
          cart.map(c=>({pedido_id:pedido.id,producto_id:c.id,cantidad:c.qty,precio_unitario:c.precio}))
        );
        // N6: Descontar stock DESPUÉS de confirmar el pedido
        for(const item of cart) {
          const nuevoStock = Math.max(0,(item.stock||0) - item.qty);
          await supabase.from("productos").update({stock:nuevoStock}).eq("id",item.id);
          await logMovimiento(item.id, "salida", item.qty, item.stock||0, nuevoStock, `Venta POS pedido #${pedido.id}`, usuario?.id||null);
        }
      }
      // Puntos
      if(cli) await supabase.from("clientes").update({puntos:(cli.puntos||0)+ptsG}).eq("id",cli.id);
      // Bitácora COFEPRIS
      const rxItems = cart.filter(c=>c.rxI);
      if(rxItems.length) {
        await supabase.from("bitacora_cofepris").insert(rxItems.map(c=>({
          medicamento:c.nombre, lote:c.lote||"", cantidad:c.qty,
