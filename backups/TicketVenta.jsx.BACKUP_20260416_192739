import React, { forwardRef } from "react";
import { QRCodeSVG } from "qrcode.react";
import "../../styles/ticket.css";

/**
 * FARMAX — Ticket térmico profesional 80mm
 * Compatible: Epson TM-T20III, Star TSP100
 */
const TicketVenta = forwardRef(({
  venta = {},
  productos = [],
  cliente = null,
  metodoPago = "Efectivo",
  config = {},
  promoMsg = null,
}, ref) => {

  const fecha = new Date(venta.created_at || Date.now());
  const fechaStr = fecha.toLocaleDateString("es-MX", { day:"2-digit", month:"2-digit", year:"numeric" });
  const horaStr  = fecha.toLocaleTimeString("es-MX", { hour:"2-digit", minute:"2-digit", second:"2-digit" });

  const subtotal  = parseFloat(venta.total || 0);
  const iva       = subtotal * 0.16;
  const total     = subtotal;
  const ptsGanados = Math.floor(total / 10);
  const fmt = n => `$${parseFloat(n||0).toFixed(2)}`;

  // Generar número de folio con ceros a la izquierda
  const folio = String(venta.id || "0").padStart(6, "0");

  return (
    <div id="farmax-ticket" ref={ref}>

      {/* ══ LOGO ══ */}
      <div className="ticket-logo">
        ★ FARMAX ★
        <span>FARMACIA &amp; SALUD</span>
      </div>

      {/* ══ HEADER ══ */}
      <div className="ticket-header">
        <div className="pharmacy-address">
          {config.direccion_farmacia || "Chinampac de Juárez, Iztapalapa, CDMX"}
        </div>
        {config.rfc && (
          <div className="pharmacy-contact">RFC: {config.rfc}</div>
        )}
        {config.telefono_farmacia && (
          <div className="pharmacy-contact">Tel: {config.telefono_farmacia}</div>
        )}
      </div>

      <hr className="separator-solid"/>

      {/* ══ FOLIO Y FECHA ══ */}
      <div className="ticket-meta"><span className="label">FOLIO:</span><span className="value">#{folio}</span></div>
      <div className="ticket-meta"><span className="label">FECHA:</span><span className="value">{fechaStr}</span></div>
      <div className="ticket-meta"><span className="label">HORA: </span><span className="value">{horaStr}</span></div>
      {cliente && (
        <div className="ticket-meta"><span className="label">CLIENTE:</span><span className="value">{(cliente.nombre||"—").slice(0,16)}</span></div>
      )}

      <div className="separator-text">- - - - - - - - - - - - - - - - -</div>

      {/* ══ TABLA DE PRODUCTOS ══ */}
      <table className="ticket-table">
        <thead>
          <tr>
            <th style={{width:"110px"}}>Producto</th>
            <th className="center" style={{width:"25px"}}>Cant</th>
            <th className="right"  style={{width:"50px"}}>P.Unit</th>
            <th className="right"  style={{width:"55px"}}>Total</th>
          </tr>
        </thead>
        <tbody>
          {productos.map((p, i) => {
            const nombre = (p.nombre || "Producto").slice(0, 18);
            const qty    = p.qty || p.cantidad || 1;
            const precio = parseFloat(p.precio || p.precio_unitario || 0);
            const ptotal = precio * qty;
            const esRx   = p.rxI || p.requiere_receta;
            return (
              <tr key={i}>
                <td className="prod-name">
                  {nombre}
                  {esRx && <span className="prod-rx">Rx</span>}
                  {p.esUnidad && <span style={{fontSize:"8px",color:"#555"}}> (u)</span>}
                </td>
                <td className="center">{qty}</td>
                <td className="right">{fmt(precio)}</td>
                <td className="right text-bold">{fmt(ptotal)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <div className="separator-text">- - - - - - - - - - - - - - - - -</div>

      {/* ══ TOTALES ══ */}
      <div className="ticket-totals">
        <div className="ticket-total-row subtotal">
          <span>Subtotal:</span>
          <span className="amount">{fmt(subtotal)}</span>
        </div>
        <div className="ticket-total-row iva">
          <span>IVA incluido (16%):</span>
          <span className="amount">{fmt(iva)}</span>
        </div>
        <div className="ticket-total-row total-final">
          <span>TOTAL:</span>
          <span className="amount">{fmt(total)}</span>
        </div>
      </div>

      <hr className="separator"/>

      {/* ══ MÉTODO DE PAGO ══ */}
      <div className="ticket-pago">
        <span>Forma de pago:</span>
        <span style={{fontWeight:"bold"}}>{metodoPago}</span>
      </div>

      {/* ══ PUNTOS FARMAX ══ */}
      {ptsGanados > 0 && (
        <div className="ticket-puntos">
          ⭐ PUNTOS FARMAX GANADOS
          <span className="pts-value">+{ptsGanados} puntos</span>
          {cliente && <span style={{fontSize:"9px"}}>Saldo: {(cliente.puntos||0)+ptsGanados} pts = ${(((cliente.puntos||0)+ptsGanados)*0.5).toFixed(0)}</span>}
        </div>
      )}

      <hr className="separator"/>

      {/* ══ MENSAJE PROMOCIONAL (dinámico) ══ */}
      {promoMsg && (
        <div className="ticket-footer">
          <div className="promo-msg">🏷️ {promoMsg}</div>
        </div>
      )}

      {/* ══ QR CODE REAL ══ */}
      {(() => {
        // Formato: FARMAX|folio|total|fecha
        const qrData = [
          "FARMAX",
          folio,
          total.toFixed(2),
          fechaStr,
          venta.id||"0",
        ].join("|");
        return (
          <div style={{display:"flex",flexDirection:"column",alignItems:"center",margin:"8px 0"}}>
            <QRCodeSVG
              value={qrData}
              size={90}
              bgColor="#ffffff"
              fgColor="#000000"
              level="M"
              includeMargin={false}
            />
            <div style={{fontSize:"7px",color:"#999",marginTop:3,textAlign:"center"}}>
              Escanea para verificar tu compra<br/>
              FARMAX|{folio}|${total.toFixed(2)}|{fechaStr}
            </div>
          </div>
        );
      })()}

      {/* ══ FOOTER ══ */}
      <div className="ticket-footer">
        <span className="gracias">¡Gracias por su compra!</span>
        <div>Vuelva pronto a Farmax</div>
        <div>Su salud es nuestra prioridad</div>
        <div className="website">farmax-seven.vercel.app</div>
        <div className="corte">* * * * * * * * * * * * * * *</div>
      </div>

    </div>
  );
});

TicketVenta.displayName = "TicketVenta";
export default TicketVenta;
